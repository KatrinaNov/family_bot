# Токен бота от @BotFather
BOT_TOKEN=your_bot_token

# --- Хранилище на Render (бесплатный диск стирается при деплое) ---
# Вариант 1: GitHub Gist (подходит, если MongoDB даёт 403 при регистрации)
# 1) GitHub → Settings → Developer settings → Personal access tokens → Generate (scope: gist)
# 2) Создайте gist: https://gist.github.com → New gist, имя файла: family_bot_data.json, содержимое: {}
# 3) Скопируйте ID из URL: gist.github.com/username/XXXXXXXXXX → XXXXXXXXXX
GITHUB_GIST_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_GIST_ID=xxxxxxxxxx

# Вариант 2: MongoDB Atlas (если регистрация доступна)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/family_bot

# Опционально: Telegram ID админа (подтверждение «Всё»). Узнать: бот @userinfobot
# ADMIN_TELEGRAM_ID=123456789
